                      "type": "number-percent",
                      "decimalPlaces": {
                        "type": "max",
                        "places": 1
                      }
                    }
                  },
                  {
                    "fieldName": "receita",
                    "displayName": "Receita",
                    "format": {
                      "type": "number-currency",
                      "currencyCode": "BRL",
                      "abbreviation": "compact",
                      "decimalPlaces": {
                        "type": "max",
                        "places": 2
                      }
                    }
                  },
                  {
                    "fieldName": "preco_a_confirmar",
                    "displayName": "Preço a confirmar"
                  }
                ]
              },
              "frame": {
                "showTitle": true,
                "title": "Produtos mais caros que todos: fila de ação"
              }
            }
          },
          "position": {
            "x": 0,
            "y": 17,
            "width": 12,
            "height": 8
          }
