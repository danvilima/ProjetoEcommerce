                  {
                    "fieldName": "categoria",
                    "displayName": "Categoria"
                  },
                  {
                    "fieldName": "nosso_preco",
                    "displayName": "Nosso preço",
                    "format": {
                      "type": "number-currency",
                      "currencyCode": "BRL",
                      "abbreviation": "compact",
                      "decimalPlaces": {
                        "type": "max",
                        "places": 2
                      }
                    }
                  },
                  {
                    "fieldName": "preco_medio_concorrentes",
                    "displayName": "Preço médio concorrentes",
                    "format": {
                      "type": "number-currency",
                      "currencyCode": "BRL",
                      "abbreviation": "compact",
                      "decimalPlaces": {
                        "type": "max",
                        "places": 2
                      }
                    }
                  },
                  {
                    "fieldName": "preco_minimo_concorrentes",
                    "displayName": "Preço mínimo concorrentes",
                    "format": {
                      "type": "number-currency",
                      "currencyCode": "BRL",
                      "abbreviation": "compact",
                      "decimalPlaces": {
                        "type": "max",
                        "places": 2
                      }
                    }
                  },
                  {
                    "fieldName": "diferenca_pct_vs_media",
