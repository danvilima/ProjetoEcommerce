{
  "datasets": [
    {
      "name": "sales",
      "displayName": "Vendas detalhadas",
      "queryLines": [
        "SELECT id_venda, data, dia_semana, dia_semana_num, hora, CASE WHEN canal_venda = 'ecommerce' THEN 'E-commerce' ELSE 'Loja física' END AS canal_venda, id_produto, nome_produto, categoria, quantidade, receita FROM vendas_detalhadas\n"
      ]
    },
    {
      "name": "top10",
      "displayName": "Top 10 produtos",
      "queryLines": [
        "WITH b AS (SELECT id_produto,nome_produto,SUM(receita) receita FROM vendas_detalhadas WHERE data BETWEEN :periodo.min AND :periodo.max AND (size(:canais)=0 OR (array_contains(:canais,'E-commerce') AND canal_venda='ecommerce') OR (array_contains(:canais,'Loja física') AND canal_venda='loja_fisica')) GROUP BY id_produto,nome_produto), r AS (SELECT *,ROW_NUMBER() OVER(ORDER BY receita DESC,id_produto) posicao FROM b) SELECT id_produto,nome_produto,receita,posicao FROM r WHERE posicao<=10 ORDER BY posicao\n"
      ],
      "parameters": [
        {
          "keyword": "periodo",
          "dataType": "DATE",
          "complexType": "RANGE",
          "defaultSelection": {
            "range": {
              "dataType": "DATE",
              "min": {
                "value": "2025-12-13"
              },
              "max": {
                "value": "2026-01-11"
              }
            }
          },
          "displayName": "Período de vendas"
        },
        {
          "keyword": "canais",
          "dataType": "STRING",
          "complexType": "MULTI",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": []
            }
          },
          "displayName": "Canais de venda"
        }
      ]
    }
  ],
