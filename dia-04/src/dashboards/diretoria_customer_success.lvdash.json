{
  "datasets": [
    {
      "name": "customers",
      "displayName": "Carteira de clientes",
      "queryLines": [
        "SELECT id_cliente,nome_cliente,estado,regiao,total_compras,receita,ticket_medio,ultima_compra,segmento_cliente FROM clientes_segmentacao\n"
      ]
    }
  ],
  "pages": [
    {
      "name": "visao-geral",
      "displayName": "Diretoria Customer Success",
      "pageType": "PAGE_TYPE_CANVAS",
      "layoutVersion": "GRID_V1",
      "layout": [
        {
          "widget": {
            "name": "titulo",
            "multilineTextboxSpec": {
              "lines": [
                "# Diretoria de Customer Success\n"
              ]
            }
          },
          "position": {
            "x": 0,
            "y": 0,
            "width": 12,
            "height": 1
          }
        },
        {
          "widget": {
            "name": "subtitulo",
            "multilineTextboxSpec": {
              "lines": [
                "Fonte: gold.clientes_segmentacao | Carteira no período de 13/12/2025 a 11/01/2026"
              ]
            }
          },
          "position": {
            "x": 0,
            "y": 1,
            "width": 12,
            "height": 1
          }
        },
        {
          "widget": {
            "name": "kpi-clientes",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "customers",
                  "fields": [
                    {
                      "name": "clientes_total",
                      "expression": "COUNT(DISTINCT `id_cliente`)"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": {
                  "fieldName": "clientes_total",
                  "displayName": "Clientes",
                  "format": {
                    "type": "number",
                    "abbreviation": "compact",
                    "decimalPlaces": {
                      "type": "max",
                      "places": 0
                    }
                  }
                }
              },
              "frame": {
                "showTitle": true,
                "title": "Clientes"
              }
            }
          },
          "position": {
            "x": 0,
            "y": 2,
            "width": 3,
            "height": 3
          }
        },
        {
          "widget": {
            "name": "kpi-vip",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "customers",
                  "fields": [
                    {
                      "name": "vip_total",
                      "expression": "SUM(CASE WHEN `segmento_cliente`='VIP' THEN 1 ELSE 0 END)"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": {
                  "fieldName": "vip_total",
                  "displayName": "Clientes VIP",
                  "format": {
                    "type": "number",
                    "abbreviation": "compact",
                    "decimalPlaces": {
                      "type": "max",
                      "places": 0
                    }
                  }
                }
              },
              "frame": {
                "showTitle": true,
                "title": "Clientes VIP"
              }
            }
          },
          "position": {
            "x": 3,
            "y": 2,
            "width": 3,
            "height": 3
          }
        },
        {
          "widget": {
            "name": "kpi-receita-vip",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "customers",
                  "fields": [
                    {
                      "name": "receita_vip_pct",
                      "expression": "SUM(CASE WHEN `segmento_cliente`='VIP' THEN `receita` ELSE 0 END)/SUM(`receita`)"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": {
                  "fieldName": "receita_vip_pct",
                  "displayName": "% da receita de VIP",
                  "format": {
                    "type": "number-percent",
                    "decimalPlaces": {
                      "type": "max",
                      "places": 1
                    }
                  }
                }
              },
              "frame": {
                "showTitle": true,
                "title": "% da receita de VIP"
              }
            }
          },
          "position": {
            "x": 6,
            "y": 2,
            "width": 3,
            "height": 3
          }
        },
        {
          "widget": {
            "name": "kpi-ticket",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "customers",
                  "fields": [
                    {
                      "name": "ticket_medio_total",
                      "expression": "SUM(`receita`)/SUM(`total_compras`)"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": {
                  "fieldName": "ticket_medio_total",
                  "displayName": "Ticket médio",
                  "format": {
                    "type": "number-currency",
                    "currencyCode": "BRL",
                    "abbreviation": "compact",
                    "decimalPlaces": {
                      "type": "max",
                      "places": 2
                    }
                  }
                }
              },
              "frame": {
                "showTitle": true,
                "title": "Ticket médio"
              }
            }
          },
          "position": {
            "x": 9,
            "y": 2,
            "width": 3,
            "height": 3
          }
        },
        {
          "widget": {
            "name": "clientes-segmento",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "customers",
                  "fields": [
                    {
                      "name": "segmento_cliente",
                      "expression": "`segmento_cliente`"
                    },
                    {
                      "name": "clientes_segmento",
                      "expression": "COUNT(DISTINCT `id_cliente`)"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 3,
              "widgetType": "bar",
              "encodings": {
                "x": {
                  "fieldName": "segmento_cliente",
                  "scale": {
                    "type": "categorical"
                  }
                },
                "y": {
                  "fieldName": "clientes_segmento",
                  "scale": {
                    "type": "quantitative"
                  }
                }
              },
              "frame": {
                "showTitle": true,
                "title": "Clientes por segmento"
              }
            }
          },
          "position": {
            "x": 0,
            "y": 5,
            "width": 6,
            "height": 5
          }
        },
        {
          "widget": {
            "name": "receita-segmento",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "customers",
                  "fields": [
                    {
                      "name": "segmento_cliente",
                      "expression": "`segmento_cliente`"
                    },
                    {
                      "name": "receita_segmento",
                      "expression": "SUM(`receita`)"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 3,
              "widgetType": "bar",
              "encodings": {
                "x": {
                  "fieldName": "segmento_cliente",
                  "scale": {
                    "type": "categorical"
                  }
                },
                "y": {
                  "fieldName": "receita_segmento",
                  "scale": {
                    "type": "quantitative"
                  }
                }
              },
              "frame": {
                "showTitle": true,
                "title": "Receita por segmento"
              }
            }
          },
          "position": {
            "x": 6,
            "y": 5,
            "width": 6,
            "height": 5
          }
        },
        {
          "widget": {
            "name": "receita-regiao",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "customers",
                  "fields": [
                    {
                      "name": "regiao",
                      "expression": "`regiao`"
                    },
                    {
                      "name": "receita_regiao",
                      "expression": "SUM(`receita`)"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 3,
              "widgetType": "bar",
              "encodings": {
                "x": {
                  "fieldName": "regiao",
                  "scale": {
                    "type": "categorical"
                  }
                },
                "y": {
                  "fieldName": "receita_regiao",
                  "scale": {
                    "type": "quantitative"
                  }
                }
              },
              "frame": {
                "showTitle": true,
                "title": "Receita por região"
              }
            }
          },
          "position": {
            "x": 0,
            "y": 10,
            "width": 12,
            "height": 5
          }
        },
        {
          "widget": {
            "name": "ranking-clientes",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "customers",
                  "fields": [
                    {
                      "name": "nome_cliente",
                      "expression": "`nome_cliente`"
                    },
                    {
                      "name": "estado",
                      "expression": "`estado`"
                    },
                    {
                      "name": "regiao",
                      "expression": "`regiao`"
                    },
                    {
                      "name": "segmento_cliente",
                      "expression": "`segmento_cliente`"
                    },
                    {
                      "name": "total_compras",
                      "expression": "`total_compras`"
                    },
                    {
                      "name": "receita",
                      "expression": "`receita`"
                    },
                    {
                      "name": "ultima_compra",
                      "expression": "`ultima_compra`"
                    }
                  ],
                  "disaggregated": true
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "table",
              "encodings": {
                "columns": [
                  {
                    "fieldName": "nome_cliente",
                    "displayName": "Cliente"
                  },
                  {
                    "fieldName": "estado",
                    "displayName": "Estado"
                  },
                  {
                    "fieldName": "regiao",
                    "displayName": "Região"
                  },
                  {
                    "fieldName": "segmento_cliente",
                    "displayName": "Segmento"
                  },
                  {
                    "fieldName": "total_compras",
                    "displayName": "Compras",
                    "format": {
                      "type": "number",
                      "abbreviation": "compact",
                      "decimalPlaces": {
                        "type": "max",
                        "places": 0
                      }
                    }
                  },
                  {
                    "fieldName": "receita",
                    "displayName": "Receita",
                    "format": {
                      "type": "number-currency",
                      "currencyCode": "BRL",
                      "abbreviation": "compact",
                      "decimalPlaces": {
                        "type": "max",
                        "places": 2
                      }
                    }
                  },
                  {
                    "fieldName": "ultima_compra",
                    "displayName": "Última compra"
                  }
                ]
              },
              "frame": {
                "showTitle": true,
                "title": "Ranking de clientes"
              }
            }
          },
          "position": {
            "x": 0,
            "y": 15,
            "width": 12,
            "height": 7
          }
        }
      ]
    },
    {
