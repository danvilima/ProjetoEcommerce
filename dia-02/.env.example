# Copie este arquivo para .env e preencha com suas credenciais reais.
# NUNCA commite o arquivo .env no Git.

# Endpoint S3-compatible do Supabase Storage
# Encontrado em: Project Settings -> Storage -> S3 Connection
SUPABASE_ENDPOINT_URL=https://SEU_PROJECT_REF.storage.supabase.co/storage/v1/s3

# Região do projeto Supabase (também disponível em S3 Connection)
SUPABASE_REGION=ca-central-1

# Credenciais S3 do Supabase Storage (diferentes da anon key / service_role key)
SUPABASE_ACCESS_KEY_ID=
SUPABASE_SECRET_ACCESS_KEY=

# Nome do bucket de origem dos dados
SUPABASE_BUCKET=Storage DataLake Ecommerce
